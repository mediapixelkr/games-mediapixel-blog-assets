      "widgets_values": [
        "{\n  \"high_level_description\": \"A single continuous horizontal 16:9 children's book illustration of a warm family story-time scene inside an elegant Parisian Haussmann apartment. A mother and her two young children are gathered around the same table, all three reading the same single open book together. The mother sits on the left side of the table, seen softly from behind in silhouette, leaning toward the book as she reads aloud while also looking at the same open pages. Her young son and daughter sit close together on the right side of the same table, leaning forward with joyful eager smiles, all focused on the same book. The boy wears a blue and white striped t-shirt. The girl wears a yellow t-shirt and denim overalls. The scene feels intimate, unified, cozy, elegant, and timeless.\",\n  \"style_description\": {\n    \"aesthetics\": \"children's book illustration, soft hand-painted storybook artwork, gentle expressive characters, refined Parisian interior, warm family atmosphere, delicate watercolor and gouache texture, subtle paper grain\",\n    \"lighting\": \"warm golden afternoon light filling the whole room evenly, soft shadows, cozy glow, gentle highlights on the characters and furniture\",\n    \"composition\": \"single-frame wide landscape composition, one unified room, one shared oval wooden table in perspective, mother on the left, children on the right, one single open book as the central focal point, all three characters visibly engaged with the same book, continuous background with no panel layout, seamless full-bleed illustration\",\n    \"background\": \"classic Parisian Haussmann apartment interior with elegant white boiserie wall paneling, a marble fireplace, a large ornate gold-gilded mirror, tall French windows with soft curtains, refined architectural details softly painted in the background\",\n    \"medium\": \"children's book illustration\"\n  },\n  \"color_palette\": [\"#F3D9A4\", \"#F7F1E8\", \"#B8D7F0\", \"#F2D34F\", \"#D7C3A3\", \"#C89B5A\", \"#8FA3B8\", \"#5B6B7A\"]\n}"
